# Copy to .env (gitignored) and fill in. Read by services/api (prefix MONET_).
MONET_ENV=dev
MONET_AUTH_MODE=dev

# LLM: fake (offline) | gemini | openai_compat
MONET_LLM_PROVIDER=fake
MONET_LLM_MODEL=gemini-2.5-flash
MONET_LLM_API_KEY=
# For openai_compat, e.g. Groq: https://api.groq.com/openai/v1  (model e.g. qwen/qwen3-32b)
MONET_LLM_BASE_URL=

# Monet's own Postgres (docker compose service "db"). NEVER the user's work DB.
MONET_DATABASE_URL=postgresql+asyncpg://monet:monet@localhost:54329/monet
MONET_REDIS_URL=
